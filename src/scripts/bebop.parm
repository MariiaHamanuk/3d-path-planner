# Extra ArduCopter params for the Parrot Bebop 2 model (layered on the gazebo-iris defaults).
# Starting point, not tuned: the Bebop has ~1/16 of the Iris roll inertia, so rate gains are lowered.
FRAME_CLASS 1
FRAME_TYPE 1
ATC_RAT_RLL_P 0.1
ATC_RAT_RLL_I 0.1
ATC_RAT_RLL_D 0.003
ATC_RAT_PIT_P 0.07
ATC_RAT_PIT_I 0.07
ATC_RAT_PIT_D 0.002
ATC_RAT_YAW_P 0.3
ATC_RAT_YAW_I 0.03
