<?xml version="1.0" ?>
<!--
  vo_city.world — Urban environment for visual odometry benchmarking.

  Design goals for VO testing:
    * Dense, non-repeating visual features (textured buildings, ground detail)
    * Structures at multiple depths so parallax is observable
    * Strong, consistent lighting to avoid exposure-driven feature loss
    * Asymmetric layout so pose is unambiguous (no rotational aliasing)

  Tested with Gazebo (Ignition/Gazebo Sim Fortress+ and Classic 11).
  For Classic, remove the <plugin> sensors block comment note at bottom.
-->
<sdf version="1.7">
  <world name="vo_city">

    <!-- ================= Physics ================= -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ================= Lighting ================= -->
    <!-- Directional sun kept slightly off-vertical so buildings cast
         directional shadows -> more texture gradient for feature detectors. -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 30 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.4 0.5 -0.9</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.75 0.85 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ================= Ground ================= -->
    <!-- Textured checker-like plane. A flat single-color plane gives VO
         almost nothing to track, so we use a repeating textured material. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= Buildings =================
         Buildings are placed asymmetrically at varied heights/depths.
         Distinct colors act as a stand-in for texture so feature matches
         are unambiguous across frames. Swap <material> for textured
         materials if you have an asset pack. -->

    <!-- helper macro-style: each building is a static box -->
    <model name="building_A">
      <static>true</static>
      <pose>15 8 6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>8 8 12</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>8 8 12</size></box></geometry>
          <material><ambient>0.6 0.3 0.2 1</ambient><diffuse>0.7 0.35 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="building_B">
      <static>true</static>
      <pose>-18 12 9 0 0 0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>10 6 18</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>10 6 18</size></box></geometry>
          <material><ambient>0.25 0.35 0.5 1</ambient><diffuse>0.3 0.4 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="building_C">
      <static>true</static>
      <pose>22 -14 4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6 12 8</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>6 12 8</size></box></geometry>
          <material><ambient>0.3 0.5 0.3 1</ambient><diffuse>0.35 0.6 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="building_D">
      <static>true</static>
      <pose>-14 -20 11 0 0 -0.2</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>9 9 22</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>9 9 22</size></box></geometry>
          <material><ambient>0.5 0.5 0.25 1</ambient><diffuse>0.6 0.6 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="building_E">
      <static>true</static>
      <pose>5 30 7 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>14 8 14</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>14 8 14</size></box></geometry>
          <material><ambient>0.4 0.25 0.45 1</ambient><diffuse>0.5 0.3 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="building_F">
      <static>true</static>
      <pose>-30 -2 5 0 0 0.1</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>7 14 10</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>7 14 10</size></box></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================= Street furniture =================
         Small nearby objects create high-parallax features (crucial for
         disambiguating translation vs. rotation in monocular VO). -->

    <model name="lamp_post_1">
      <static>true</static>
      <pose>3 3 2.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.15</radius><length>5</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.15</radius><length>5</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="lamp_post_2">
      <static>true</static>
      <pose>-4 -3 2.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.15</radius><length>5</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.15</radius><length>5</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="planter_box">
      <static>true</static>
      <pose>6 -2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.5 1.5 1</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>1.5 1.5 1</size></box></geometry>
          <material><ambient>0.35 0.2 0.1 1</ambient><diffuse>0.4 0.25 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="ref_pillar">
      <static>true</static>
      <pose>0 6 1.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.4</radius><length>3</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.4</radius><length>3</length></cylinder></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.9 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Origin marker: gives VO a fixed, uniquely-colored landmark at
         world origin for ground-truth alignment / drift measurement. -->
    <model name="origin_marker">
      <static>true</static>
      <pose>0 0 0.05 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.5 0.5 0.1</size></box></geometry>
          <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
