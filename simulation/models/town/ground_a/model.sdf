<?xml version="1.0"?>
<sdf version="1.9">
  <model name="ground_a">
    <static>true</static>
    <link name="link">
      <visual name="grass">
        <pose>0 0 0 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <pbr><metal>
              <albedo_map>textures/ground_a_ground_color.jpg</albedo_map>
              <normal_map>textures/ground_a_ground_normal.jpg</normal_map>
              <roughness>0.95</roughness><metalness>0.0</metalness>
            </metal></pbr>
          </material>
      </visual>
    </link>
  </model>
</sdf>
