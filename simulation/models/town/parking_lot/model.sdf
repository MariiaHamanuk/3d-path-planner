<?xml version="1.0"?>
<sdf version="1.9">
  <model name="parking_lot">
    <static>true</static>
    <link name="link">
      <visual name="lot">
        <pose>0 0 0.025 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry><box><size>12 18 0.05</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
