            <specular>0.2 0.2 0.2 1</specular>
            <pbr><metal>
              <albedo_map>textures/parking_lot_parking_color.jpg</albedo_map>
              <normal_map>textures/parking_lot_parking_normal.jpg</normal_map>
              <roughness>0.9</roughness><metalness>0.0</metalness>
            </metal></pbr>
          </material>
      </visual>
    </link>
  </model>
</sdf>
