<?xml version="1.0"?>
<sdf version="1.9">
  <model name="midrise_office">
    <static>true</static>
    <link name="link">
      <visual name="walls">
        <pose>0 0 9.0 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry><box><size>16 20 18</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <pbr><metal>
              <albedo_map>textures/midrise_office_facade_color.jpg</albedo_map>
              <normal_map>textures/midrise_office_facade_normal.jpg</normal_map>
              <roughness>0.45</roughness><metalness>0.15</metalness>
            </metal></pbr>
          </material>
      </visual>
      <visual name="roof">
        <pose>0 0 18.2 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry><box><size>16.2 20.2 0.4</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <pbr><metal>
              <albedo_map>textures/midrise_office_roof_color.jpg</albedo_map>
              <roughness>0.95</roughness><metalness>0.0</metalness>
            </metal></pbr>
          </material>
      </visual>
      <collision name="collision">
        <pose>0 0 9.2 0 0 0</pose>
        <geometry><box><size>16 20 18.4</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
